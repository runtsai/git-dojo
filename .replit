modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/git-dojo-dashboard: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/api-server: API Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "dashboard-unit-tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "teammate-missions"

[[workflows.workflow]]
name = "api-smoke"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "API_URL=http://localhost:8080 pnpm --filter @workspace/scripts run api-smoke"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "dashboard-unit-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/git-dojo-dashboard run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "teammate-missions"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash git-dojo/selftest.sh"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
packages = ["exploitdb"]
